# Copy this file to ".env" (same folder) and adjust the values.
# ⚠️ This file is pushed to GitHub: never put real values (passwords, keys…) here,
#    only in server/.env, which stays on your computer.
# 5004: Inkspire (5001), I Love Verticals (5002) and Voices of Verticals (5003) can run at the same time
PORT=5004

# Local MongoDB by default. For MongoDB Atlas, paste your connection string here
# (with the database name at the end, e.g. …mongodb.net/realreeldrama).
MONGODB_URI=mongodb://127.0.0.1:27017/real-reel-drama

# CMS sign-in with Google (the public site doesn't need it).
# Without GOOGLE_CLIENT_ID, the CMS is open without sign-in (local development only).
GOOGLE_CLIENT_ID=
# Google emails allowed to edit the content, comma-separated
ALLOWED_EMAILS=
# Long random string (32 characters minimum) that signs the sessions. To generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Production (variables to set in the host's dashboard, not in this file):
#   NODE_ENV=production  -> serves the built interface, Secure cookies, mandatory configuration
#   PORT                 -> provided by the host
#   SITE_URL             -> public address of the site (e.g. https://www.realreeldrama.com):
#                           canonical links, sitemap.xml
# CORS_ORIGIN (optional): only if the interface is served from another address
